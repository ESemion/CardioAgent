; ==================================================
; КОНФИГУРАЦИОННЫЙ ФАЙЛ CardioAgent
; ==================================================
; Скопируйте этот файл как agent.ini и заполните свои данные
; 
; Все параметры обязательны
; ==================================================

; ------------------------------------------
; УНИКАЛЬНЫЙ ИДЕНТИФИКАТОР АГЕНТА
; ------------------------------------------
; Должен быть уникальным для каждого агента.
; Можно придумать любой, например:
;   "agent_ivanov_1"
;   "holter_patient_123"
;   "test_agent_007"
; ------------------------------------------
UID = your_unique_agent_id_here

; ------------------------------------------
; ОПИСАНИЕ АГЕНТА
; ------------------------------------------
; Произвольный текст, описывающий агента.
; Используется для логирования.
; Примеры: "patient_ivanov_pc", "holter_001", "test_agent"
; ------------------------------------------
descr = your_agent_description_here

; ------------------------------------------
; АДРЕС СЕРВЕРА
; ------------------------------------------
; Обязательно с протоколом http:// или https://
; Порт указывается через двоеточие
; Пример: "https://xdev.arkcom.ru:9999"
; ------------------------------------------
server_url = https://xdev.arkcom.ru:9999

; ------------------------------------------
; ИНТЕРВАЛ ОПРОСА (в секундах)
; ------------------------------------------
; Как часто агент будет спрашивать сервер о новых заданиях.
; Минимальное значение: 5 секунд
; Рекомендуется: 5-10 секунд
; ------------------------------------------
poll_interval = 10